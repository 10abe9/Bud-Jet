<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Finance data is backed up by the system; the capture journal is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="capture_log.jsonl" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="capture_log.jsonl" />
    </device-transfer>
</data-extraction-rules>
