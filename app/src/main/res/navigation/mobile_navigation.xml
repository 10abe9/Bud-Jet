<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_dashboard">


    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.abe.bud_jet.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_operations"
        android:name="com.abe.bud_jet.ui.operations.OperationsFragment"
        android:label="Operations"
        tools:layout="@layout/fragment_operations" />
    <fragment
        android:id="@+id/navigation_analytics"
        android:name="com.abe.bud_jet.ui.analytics.AnalyticsFragment"
        android:label="Analytics"
        tools:layout="@layout/fragment_analytics" />
    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.abe.bud_jet.ui.goals.GoalsFragment"
        android:label="Goals"
        tools:layout="@layout/fragment_goals" />
</navigation>