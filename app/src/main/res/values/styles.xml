<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- CHIP STYLE -->
    <style name="Widget.App.Chip.Filter" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">16dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- ========================= -->
    <!-- BOTTOM SHEET THEME -->
    <!-- ========================= -->

    <style name="ThemeOverlay.BudJet.BottomSheet"
        parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">

        <!-- привязываем кастомный BottomSheet -->
        <item name="bottomSheetStyle">@style/Widget.BudJet.BottomSheet.Modal</item>

        <!-- затемнение фона -->
        <item name="android:backgroundDimAmount">0.4</item>

        <!-- Sheet draws behind a transparent navigation bar (set via theme, not deprecated
             Window API calls). Ignored on Android 15+, where this is the default. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>

    </style>

    <!-- ========================= -->
    <!-- BOTTOM SHEET CONTAINER -->
    <!-- ========================= -->

    <style name="Widget.BudJet.BottomSheet.Modal"
        parent="Widget.MaterialComponents.BottomSheet.Modal">

        <!-- ВАЖНО: убираем серый системный фон -->
        <item name="android:background">@android:color/transparent</item>
        <!-- Material draws the sheet's own shape with backgroundTint (colorSurface): without
             this a white/dark block shows below the card and under the navigation bar. -->
        <item name="backgroundTint">@android:color/transparent</item>

        <!-- скругления контейнера -->
        <item name="shapeAppearanceOverlay">
            @style/ShapeAppearance.BudJet.BottomSheet
        </item>

    </style>

    <!-- ========================= -->
    <!-- SHAPE (карточка контейнера) -->
    <!-- ========================= -->

    <style name="ShapeAppearance.BudJet.BottomSheet"
        parent="ShapeAppearance.MaterialComponents.LargeComponent">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>

    </style>

    <!-- ========================= -->
    <!-- TEXT INPUT STYLE -->
    <!-- ========================= -->

    <style name="Widget.BudJet.TextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="boxStrokeWidth">1dp</item>

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

        <item name="hintTextColor">@color/text_secondary</item>

    </style>

    <style name="ThemeOverlay.BudJet.AlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.BudJet.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.BudJet.AlertDialog.Body</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BudJet.AlertDialog</item>
    </style>

    <style name="TextAppearance.BudJet.AlertDialog.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.BudJet.AlertDialog.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ShapeAppearance.BudJet.AlertDialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Premium offer sheet -->
    <style name="BudJet.PremiumMathRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="BudJet.PremiumMathLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BudJet.PremiumMathValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BudJet.PremiumFeature" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:drawableStart">@drawable/ic_premium_check</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Auto-capture screen -->
    <style name="BudJet.CaptureCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Modern button text: sentence case, no extra letter spacing. -->
    <style name="TextAppearance.BudJet.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ========================= -->
    <!-- BUTTONS                   -->
    <!-- One filled button per screen for the main action; everything else is tonal or text.
         Height 52dp = 40dp visible + default 6dp touch insets (Material 3 proportions). -->
    <!-- ========================= -->

    <!-- Filled: the main action (Save, Continue, Apply). -->
    <style name="Widget.BudJet.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_content</item>
        <item name="iconTint">@color/btn_primary_content</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Tonal: secondary actions (soft brand tint). -->
    <style name="Widget.BudJet.Button.Tonal">
        <item name="backgroundTint">@color/btn_tonal_bg</item>
        <item name="android:textColor">@color/btn_tonal_content</item>
        <item name="iconTint">@color/btn_tonal_content</item>
    </style>

    <!-- Neutral tonal: Cancel and other "back out" actions. -->
    <style name="Widget.BudJet.Button.Tonal.Neutral">
        <item name="backgroundTint">@color/btn_neutral_bg</item>
        <item name="android:textColor">@color/btn_neutral_content</item>
        <item name="iconTint">@color/btn_neutral_content</item>
    </style>

    <!-- Expense tonal: add expense, and destructive confirmations (Delete). -->
    <style name="Widget.BudJet.Button.Tonal.Expense">
        <item name="backgroundTint">@color/btn_expense_bg</item>
        <item name="android:textColor">@color/btn_expense_content</item>
        <item name="iconTint">@color/btn_expense_content</item>
    </style>

    <!-- Income tonal: add income. -->
    <style name="Widget.BudJet.Button.Tonal.Income">
        <item name="backgroundTint">@color/btn_income_bg</item>
        <item name="android:textColor">@color/btn_income_content</item>
        <item name="iconTint">@color/btn_income_content</item>
    </style>

    <!-- Premium purchase: filled violet. -->
    <style name="Widget.BudJet.Button.Premium">
        <item name="backgroundTint">@color/btn_premium_bg</item>
        <item name="android:textColor">@color/btn_premium_content</item>
        <item name="iconTint">@color/btn_premium_content</item>
    </style>

    <!-- Text: low-emphasis actions in cards and lists. -->
    <style name="Widget.BudJet.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textColor">@color/btn_text_content</item>
        <item name="iconTint">@color/btn_text_content</item>
    </style>

    <!-- Expense / income segmented toggle: the selected half gets the soft tint. -->
    <style name="Widget.BudJet.Button.Segment" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BudJet.Button.Segment.Expense">
        <item name="backgroundTint">@color/segment_expense_bg</item>
        <item name="android:textColor">@color/segment_expense_content</item>
        <item name="strokeColor">@color/segment_expense_stroke</item>
    </style>

    <style name="Widget.BudJet.Button.Segment.Income">
        <item name="backgroundTint">@color/segment_income_bg</item>
        <item name="android:textColor">@color/segment_income_content</item>
        <item name="strokeColor">@color/segment_income_stroke</item>
    </style>

</resources>