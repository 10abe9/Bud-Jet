<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ai_gradient"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/premium_badge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/premium_sheet_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGenericBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/premium_sheet_generic_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Savings math: visible only when there is enough spending data -->
            <LinearLayout
                android:id="@+id/layoutSavingsMath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_premium_math"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout style="@style/BudJet.PremiumMathRow">

                    <TextView
                        style="@style/BudJet.PremiumMathLabel"
                        android:text="@string/premium_sheet_spend_label" />

                    <TextView
                        android:id="@+id/tvSpendValue"
                        style="@style/BudJet.PremiumMathValue" />
                </LinearLayout>

                <LinearLayout style="@style/BudJet.PremiumMathRow">

                    <TextView
                        style="@style/BudJet.PremiumMathLabel"
                        android:text="@string/premium_sheet_savings_label" />

                    <TextView
                        android:id="@+id/tvSavingsValue"
                        style="@style/BudJet.PremiumMathValue"
                        android:textColor="@color/finance_income" />
                </LinearLayout>

                <LinearLayout style="@style/BudJet.PremiumMathRow">

                    <TextView
                        style="@style/BudJet.PremiumMathLabel"
                        android:text="@string/premium_sheet_price_label" />

                    <TextView
                        android:id="@+id/tvPriceValue"
                        style="@style/BudJet.PremiumMathValue"
                        android:textColor="@color/finance_expense" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/border" />

                <LinearLayout style="@style/BudJet.PremiumMathRow">

                    <TextView
                        style="@style/BudJet.PremiumMathLabel"
                        android:text="@string/premium_sheet_benefit_label"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBenefitValue"
                        style="@style/BudJet.PremiumMathValue"
                        android:textColor="@color/finance_income"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/premium_sheet_disclaimer"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/premium_sheet_features_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/BudJet.PremiumFeature"
                android:text="@string/premium_feature_auto_capture" />

            <TextView
                style="@style/BudJet.PremiumFeature"
                android:text="@string/premium_feature_ai_assistant" />

            <TextView
                style="@style/BudJet.PremiumFeature"
                android:text="@string/premium_feature_export" />

            <!-- Trial and billing terms, shown before the user agrees -->
            <TextView
                android:id="@+id/tvTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuy"
                style="@style/Widget.BudJet.Button.Premium"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotNow"
                style="@style/Widget.BudJet.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/premium_offer_not_now"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
