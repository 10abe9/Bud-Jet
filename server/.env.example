# Copy to .env and fill in. Never commit .env.

# Your domain, pointing (A record) to this server's IP. Needed for HTTPS.
DOMAIN=api.example.com

# Ollama Cloud: ollama.com -> Settings -> API keys.
OLLAMA_API_KEY=
# gpt-oss:20b is fast and cheap; try gpt-oss:120b if answers are weak.
OLLAMA_MODEL=gpt-oss:20b
# Optional thinking level for models that support it: low / medium / high.
OLLAMA_THINK=

# Must match the app (Plan.kt) and Play Console.
PACKAGE_NAME=com.abe.bud_jet
PRO_PRODUCT_ID=bud_jet_premium
BASIC_PRODUCT_ID=bud_jet_base

# Per subscription per UTC day.
CHAT_DAILY_LIMIT=30
INSIGHTS_DAILY_LIMIT=10
